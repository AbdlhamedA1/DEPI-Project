{
  "name": "student-housing-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Egyptian Student Housing Platform - Modular Monolith Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run --workspaces --parallel dev",
    "dev:web": "npm run --workspace=@repo/web dev",
    "dev:api": "npm run --workspace=@repo/api dev",
    "build:packages": "npm run --workspace=@repo/shared-types build && npm run --workspace=@repo/validation build && npm run --workspace=@repo/api-client build",
    "build:apps": "npm run --workspace=@repo/api build && npm run --workspace=@repo/web build",
    "build": "npm run build:packages && npm run build:apps",
    "type-check": "npm run --workspaces --if-present type-check",
    "lint": "npm run --workspaces --if-present lint",
    "lint:fix": "npm run --workspaces --if-present lint:fix",
    "test": "npm run --workspaces --if-present test",
    "test:e2e": "npx tsx tests/runner.ts",
    "test:all": "npm test && npm run test:e2e",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "npm run --workspaces --if-present clean"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
