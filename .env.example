# Application Environment
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_housing?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=student_housing

# Authentication & Security
JWT_SECRET=dev-jwt-super-secret-key-min-32-chars-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=dev-jwt-refresh-super-secret-key-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# OTP Settings
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
SMS_GATEWAY_API_KEY=mock_dev_sms_key

# Third-Party Integrations
CLOUDINARY_CLOUD_NAME=mock_cloud
CLOUDINARY_API_KEY=mock_api_key
CLOUDINARY_API_SECRET=mock_api_secret

GOOGLE_MAPS_API_KEY=mock_google_maps_key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=mock_google_maps_key

# Private Secure Storage for KYC Documents
SECURE_STORAGE_LOCAL_PATH=./uploads/secure_kyc
SECURE_STORAGE_BUCKET=student-housing-kyc-private

# Frontend Public Settings
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_SUPPORTED_LOCALES=ar,en
